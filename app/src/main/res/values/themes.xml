<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The app previously declared no theme at all, so it inherited the platform default and its
      window never dispatched insets to Compose - which put the top app bar under the status bar
      where the system swallows touches. A real theme is what makes edge-to-edge work.
    -->
    <style name="Theme.Music" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
