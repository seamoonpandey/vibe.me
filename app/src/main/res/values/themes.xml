<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The app previously declared no theme at all, so it inherited the platform default and its
      window never dispatched insets to Compose - which put the top app bar under the status bar
      where the system swallows touches. A real theme is what makes edge-to-edge work.
    -->
    <style name="Theme.Music" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!--
      The window theme the system paints before the first frame. Without one, launching shows a
      blank white slab; with it the app icon is on the app's own ground from the first millisecond.
      Nothing is held back waiting for the library - the splash hands over as soon as Compose draws.
    -->
    <style name="Theme.Music.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Music</item>
    </style>
</resources>
