            android:pathData="M65,52 m-4,0 a4,4.5 0 1,0 8,0 a4,4.5 0 1,0 -8,0 Z" />
        <path android:fillColor="#FFFFFF"
            android:pathData="M44.6,50.2 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" />
        <path android:fillColor="#FFFFFF"
            android:pathData="M66.6,50.2 m-1.4,0 a1.4,1.4 0 1,0 2.8,0 a1.4,1.4 0 1,0 -2.8,0 Z" />

        <!-- Headphones over the top. -->
        <path android:strokeColor="#1DB954" android:strokeWidth="5.5" android:strokeLineCap="round"
