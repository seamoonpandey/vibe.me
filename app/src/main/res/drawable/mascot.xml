        <path android:fillColor="#F0D6B8"
            android:pathData="M54,56 m-27,0 a27,25 0 1,0 54,0 a27,25 0 1,0 -54,0 Z" />

        <!-- Muzzle. -->
        <path android:fillColor="#FBEEDF"
            android:pathData="M54,68 m-14,0 a14,11 0 1,0 28,0 a14,11 0 1,0 -28,0 Z" />

        <!-- Nose and mouth. -->
        <path android:fillColor="#3B2A22"
            android:pathData="M54,62 m-5,0 a5,4 0 1,0 10,0 a5,4 0 1,0 -10,0 Z" />
        <path android:strokeColor="#3B2A22" android:strokeWidth="2" android:strokeLineCap="round"
            android:pathData="M54,66 L54,71 M54,71 q-5,4 -9,0 M54,71 q5,4 9,0" />

