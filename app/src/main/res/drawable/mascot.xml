    android:viewportWidth="108" android:viewportHeight="108">

    <!-- A puppy in headphones. One group, so the animation can move the whole face at once. -->
    <group android:name="mascot" android:pivotX="54" android:pivotY="58">

        <!-- Floppy ears sit behind the head. -->
        <path android:fillColor="#C98A5B"
            android:pathData="M29,44 m-10,0 a10,18 0 1,0 20,0 a10,18 0 1,0 -20,0 Z" />
        <path android:fillColor="#C98A5B"
            android:pathData="M79,44 m-10,0 a10,18 0 1,0 20,0 a10,18 0 1,0 -20,0 Z" />

