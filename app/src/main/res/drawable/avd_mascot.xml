<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/mascot">

    <target android:name="mascot">
        <aapt:attr name="android:animation" xmlns:aapt="http://schemas.android.com/aapt">
            <set android:ordering="together">
                <objectAnimator
                    android:propertyName="scaleX" android:valueFrom="0.70" android:valueTo="1.0"
                    android:duration="600" android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator
                    android:propertyName="scaleY" android:valueFrom="0.70" android:valueTo="1.0"
                    android:duration="600" android:interpolator="@android:interpolator/overshoot" />
                <!-- Head tilt, the way a dog does when it hears something. -->
                <objectAnimator
                    android:propertyName="rotation" android:valueFrom="-16" android:valueTo="9"
                    android:duration="520" android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="rotation" android:valueFrom="9" android:valueTo="0"
                    android:startOffset="520" android:duration="320"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
